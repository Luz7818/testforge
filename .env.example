# Copy to .env to enable real LLM experiments (or just export in your shell).
# .env at the repo root is loaded automatically when testforge.config is
# imported; precedence is shell export > .env > the defaults in config.py, so an
# exported value always wins and .env only fills gaps. No file, or an empty
# value, is treated as "not configured": `--mode api` then stops with guidance
# instead of calling the network with a blank credential.
# Comments must be on their own line (inline `#` is kept as part of the value).
# DeepSeek platform: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# TESTFORGE_MODEL=deepseek-chat
# TESTFORGE_API_BASE=https://api.deepseek.com

# Extra JSON merged into each chat-completions request body (provider-specific
# knobs). Example for Qwen3-family models:
#   DashScope-style:  TESTFORGE_EXTRA_BODY={"enable_thinking": false}
#   vLLM native:      TESTFORGE_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# TESTFORGE_EXTRA_BODY=

# ── Example: any self-hosted OpenAI-compatible endpoint (vLLM, Ollama, ...) ──
# Unauthenticated servers: any non-empty key string works.
# DEEPSEEK_API_KEY=EMPTY
# TESTFORGE_API_BASE=http://<host>:<port>/v1
# TESTFORGE_MODEL=<model-name>
# TESTFORGE_EXTRA_BODY={"enable_thinking": false}
# Response length ceiling: one response carries all K candidates, so raise this
# together with --candidates (at the default 2048 a round of 8 candidates is
# truncated after roughly 3 of them).
# TESTFORGE_MAX_TOKENS=6144
# Response cache directory (default: <project>/llm_cache). Set this to a fresh
# directory when a run must sample independently instead of replaying cached
# completions bit-for-bit.
# TESTFORGE_CACHE_DIR=llm_cache_replicate
